# Parking Papi Mobile App Environment Variables
# Copy this file to .env and update with your actual values

# API Configuration
API_BASE_URL=https://your-laravel-cloud-domain.com/api
WEB_BASE_URL=https://your-laravel-cloud-domain.com

# App Configuration
APP_ENVIRONMENT=development
API_TIMEOUT=10000

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false

# Development Settings
DEBUG_MODE=true
LOG_LEVEL=debug

# App Store Configuration (for production builds)
EXPO_APPLE_ID=your-apple-id@example.com
EXPO_APPLE_TEAM_ID=your-apple-team-id